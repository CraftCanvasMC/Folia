From: File <noreply+automated@papermc.io>
Date: Sun, 20 Apr 1997 15:37:42 +0200
Subject: [PATCH] folia File Patches


diff --git a/net/minecraft/world/level/block/LightningRodBlock.java b/net/minecraft/world/level/block/LightningRodBlock.java
index 8399256a819bf70a0a943c404c82dbbbbea9267c..47ca45518df306cc4368983eefb89294e56b015a 100644
--- a/net/minecraft/world/level/block/LightningRodBlock.java
+++ b/net/minecraft/world/level/block/LightningRodBlock.java
@@ -117,7 +117,7 @@ public class LightningRodBlock extends RodBlock implements SimpleWaterloggedBloc
     @Override
     public void animateTick(final BlockState state, final Level level, final BlockPos pos, final RandomSource random) {
         if (level.isThundering()
-            && level.getRandom().nextInt(200) <= level.getGameTime() % 200L
+            && level.getRandom().nextInt(200) <= level.getRedstoneGameTime() % 200L // Folia - region threading
             && pos.getY() == level.getHeight(Heightmap.Types.WORLD_SURFACE, pos.getX(), pos.getZ()) - 1) {
             ParticleUtils.spawnParticlesAlongAxis(state.getValue(FACING).getAxis(), level, pos, 0.125, ParticleTypes.ELECTRIC_SPARK, UniformInt.of(1, 2));
         }
